{
  "name": "scholaxia-desktop",
  "version": "1.0.7",
  "description": "Scholaxia Portal — Windows Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis portable --x64",
    "build:admin": "electron-builder --config electron-builder-admin.json --win nsis portable --x64"
  },
  "author": "Scholaxia",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.scholaxia.desktop",
    "productName": "Scholaxia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "executableName": "ScholaxiaStudent",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Scholaxia",
      "runAfterFinish": false,
      "artifactName": "Scholaxia-Student-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Scholaxia-Student-Portable-${version}.${ext}"
    },
    "files": [
      "main.js",
      "desktop-server.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/admin.html",
      "!renderer/teacher.html",
      "!renderer/js/admin.js",
      "!renderer/js/admin-api.js",
      "!renderer/js/teacher.js",
      "!renderer/js/teacher-api.js",
      "!renderer/js/teacher-notifications.js",
      "!renderer/css/admin.css",
      "!renderer/css/teacher.css",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "launch/Scholaxia.bat",
        "to": "Scholaxia.bat"
      }
    ],
    "extraResources": [
      {
        "from": "INSTALL-FOR-FRIEND.txt",
        "to": "INSTALL-FOR-FRIEND.txt"
      }
    ]
  }
}
